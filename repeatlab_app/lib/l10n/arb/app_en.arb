    "changelog170Title": "Back up and move your library",
    "changelog170Description": "Export your entire library — songs, loops, and audio — to a single file, then restore it on another device with Pro. Choose Merge to add new songs alongside your existing ones, or Replace to start fresh.",
    "changelog170LanguageTitle": "Choose your language",
    "@changelog170LanguageTitle": {
        "description": "Changelog entry title for the 1.7.0 language switcher feature"
    },
    "changelog170LanguageDescription": "Switch the app language from the drawer — pick from 16 supported languages or follow your device's system default.",
    "@changelog170LanguageDescription": {
