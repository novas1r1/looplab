---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RepeatLab - Loop your music practice">
  <script
  src="https://cdn.telemetrydeck.com/websdk/telemetrydeck.min.js"
  data-app-id="B19DAFCB-056C-4F08-974B-ABA8F42C2E5F"
  ></script>
  <main>
    <!-- Hero Section -->
    <section class="py-20 px-4 md:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto text-center">
        <h1
          class="text-4xl md:text-6xl font-display font-bold text-primary mb-6"
        >
          Master Your Music Practice with RepeatLab
        </h1>
        <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto text-secondary">
          Create perfect practice loops, adjust music speed and improve your
          musical skills with our intuitive looping tool.
        </p>
        <div class="flex justify-center gap-4">
          <a
            href="https://apps.apple.com/us/app/audio-looper-speed-changer/id6740175553"
            target="_blank"
            class="flex items-center gap-1"
          >
            <img
              src="/images/app-store-badge-black.png"
              alt="Download on App Store"
              class="h-12"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.repeatlab.app"
            target="_blank"
            class="flex items-center gap-1"
          >
            <img
              src="/images/google-play-badge.png"
              alt="Get it on Google Play"
              class="h-12"
            />
          </a>
        </div>
      </div>
    </section>

    <!-- Screenshots Section -->
    <section class="py-12 bg-surface">
      <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
        <h2
          class="text-3xl md:text-4xl font-display font-bold text-center mb-12 text-primary"
        >
          RepeatLab in Action
        </h2>
        <div
          class="grid md:grid-cols-4 gap-4 items-center justify-items-center"
        >
          <div></div>
          <div class="relative w-full max-w-[300px]">
            <img
              src="/images/screenshot1.png"
              alt="RepeatLab App Screenshot"
              class="rounded-3xl shadow-lg"
            />
          </div>
          <div class="relative w-full max-w-[300px]">
            <img
              src="/images/screenshot2.png"
              alt="RepeatLab App Interface"
              class="rounded-3xl shadow-lg"
            />
          </div>
          <div></div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-20 bg-surface-container">
      <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
        <h2
          class="text-3xl md:text-4xl font-display font-bold text-center mb-12 text-primary"
        >
          Features
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div
              class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-8 h-8 text-surface"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Precise Looping
            </h3>
            <p class="text-secondary">
              Create exact loops for any section of your music with millisecond
              precision.
            </p>
          </div>
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div
              class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-8 h-8 text-surface"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Multiple Loops
            </h3>
            <p class="text-secondary">
              Set up multiple practice loops within the same song for efficient
              practice sessions.
            </p>
          </div>
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div
              class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-8 h-8 text-surface"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 0 1 0 1.954l-7.108 4.061A1.125 1.125 0 0 1 3 16.811V8.69ZM12.75 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 0 1 0 1.954l-7.108 4.061a1.125 1.125 0 0 1-1.683-.977V8.69Z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Change Music Speed
            </h3>
            <p class="text-secondary">
              Slow down or speed up your music to practice at a slower or faster
              tempo.
            </p>
          </div>
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div
              class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-8 h-8 text-surface"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.75 5.25v13.5m-7.5-13.5v13.5"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Easy Navigation
            </h3>
            <p class="text-secondary">
              Jump between sections easily with our intuitive interface.
            </p>
          </div>
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div
              class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-8 h-8 text-surface"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">
              No Ads & Registration Required
            </h3>
            <p class="text-secondary">
              No ads, no registration, instant start.
            </p>
          </div>
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div
              class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-8 h-8 text-surface"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 3l8.735 8.735m0 0a.374.374 0 11.53.53m-.53-.53l.53.53m0 0L21 21M14.652 9.348a3.75 3.75 0 010 5.304m2.121-7.425a6.75 6.75 0 010 9.546m2.121-11.667c3.808 3.807 3.808 9.98 0 13.788m-9.546-4.242a3.733 3.733 0 01-1.06-2.122m-1.061 4.243a6.75 6.75 0 01-1.625-6.929m-.496 9.05c-3.068-3.067-3.664-7.67-1.79-11.334M12 12h.008v.008H12V12z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">
              No Internet Connection Required
            </h3>
            <p class="text-secondary">Everything stays on your device.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 px-4 md:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2
          class="text-3xl md:text-4xl font-display font-bold text-center mb-12 text-primary"
        >
          Frequently Asked Questions
        </h2>
        <div class="space-y-6">
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">
              What devices does RepeatLab support?
            </h3>
            <p class="text-secondary">
              RepeatLab is currently available for iOS and Android devices.
            </p>
          </div>
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Can I import my own music?
            </h3>
            <p class="text-secondary">
              Yes, you can import your own music files in various formats
              including MP3 and WAV.
            </p>
          </div>
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Is there a limit to how many loops I can create?
            </h3>
            <p class="text-secondary">
              No, you can create as many loops as you need within each song.
            </p>
          </div>
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Can I slow down or speed up the music?
            </h3>
            <p class="text-secondary">
              Yes, you can slow down (until 0.5x) or speed up (until 2x) the
              music to practice at a slower or faster tempo.
            </p>
          </div>
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Can I import music from spotify or apple music?
            </h3>
            <p class="text-secondary">
              No, this is not possible yet because of the limitations of the
              audio streaming services.
            </p>
          </div>
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Can I loop specific sections of YouTube videos?
            </h3>
            <p class="text-secondary">
              Not yet, but I'm working on it. Let me know if you want this
              feature!
            </p>
          </div>
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Is this app free?
            </h3>
            <p class="text-secondary">
              It's free for unlimited songs and one loop per song. If you need
              more loops per song and want to change music speed you can buy a
              yearly subscription or go with the lifetime license.
            </p>
          </div>

          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">
              Is this app getting new features?
            </h3>
            <p class="text-secondary">
              Yes, I'm working on new features and improvements. Let me know if
              you want a specific feature!
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-primary text-surface">
      <div class="max-w-4xl mx-auto text-center px-4 md:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-display font-bold mb-6">
          Ready to Transform Your Practice?
        </h2>
        <p class="text-xl mb-8">
          Download RepeatLab today and take your music practice to the next
          level.
        </p>
        <div class="flex justify-center gap-4">
          <a
            href="https://apps.apple.com/us/app/audio-looper-speed-changer/id6740175553"
            target="_blank"
            class="flex items-center gap-2"
            onclick="window.telemetrydeck.send({type: 'app_store_click'})"
          >
            <img
              src="/images/app-store-badge-black.png"
              alt="Download on App Store"
              class="h-12"
            />
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.repeatlab.app"
            target="_blank"
            class="flex items-center gap-2"
            onclick="window.telemetrydeck.send({type: 'google_play_click'})"
          >
            <img
              src="/images/google-play-badge.png"
              alt="Get it on Google Play"
              class="h-12"
            />
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-surface-container text-secondary py-8">
    <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-4">
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/privacy" class="hover:text-primary transition-colors" 
            onclick="window.telemetrydeck.send({type: 'privacy_policy_click'})"
            >Privacy Policy</a
          >
          <a href="/legal" class="hover:text-primary transition-colors"
            onclick="window.telemetrydeck.send({type: 'legal_notices_click'})"
            >Legal Notices</a
          >
          <a href="/terms" class="hover:text-primary transition-colors"
            onclick="window.telemetrydeck.send({type: 'terms_and_conditions_click'})"
            >Terms & Conditions</a
          >
        </div>
        <p>&copy; {new Date().getFullYear()} RepeatLab</p>
      </div>
    </div>
  </footer>
</Layout>
