---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RepeatLab - Loop your music practice">
  <main>
    <!-- Hero Section -->
    <section class="py-20 px-4 md:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-display font-bold text-primary mb-6">
          Master Your Music Practice with RepeatLab
        </h1>
        <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto text-secondary">
          Create perfect practice loops, track your progress, and improve your musical skills with our intuitive looping tool.
        </p>
        <div class="flex justify-center gap-4">
          <a href="https://apps.apple.com/us/app/audio-looper-speed-changer/id6740175553" target="_blank" class="flex items-center gap-2">
            <img src="/images/app-store-badge-black.png" alt="Download on App Store" class="h-12">
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.repeatlab.app" target="_blank" class="flex items-center gap-2">
            <img src="/images/google-play-badge.png" alt="Get it on Google Play" class="h-12">
          </a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-20 bg-surface-container">
      <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-center mb-12 text-primary">Features</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center">
              <!-- Icon placeholder -->
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">Precise Looping</h3>
            <p class="text-secondary">Create exact loops for any section of your music with millisecond precision.</p>
          </div>
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center">
              <!-- Icon placeholder -->
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">Multiple Loops</h3>
            <p class="text-secondary">Set up multiple practice loops within the same song for efficient practice sessions.</p>
          </div>
          <div class="text-center p-6 bg-surface-bright rounded-lg">
            <div class="w-16 h-16 bg-primary rounded-full mx-auto mb-4 flex items-center justify-center">
              <!-- Icon placeholder -->
            </div>
            <h3 class="text-xl font-bold mb-2 text-secondary">Easy Navigation</h3>
            <p class="text-secondary">Jump between sections easily with our intuitive interface.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 px-4 md:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-center mb-12 text-primary">Frequently Asked Questions</h2>
        <div class="space-y-6">
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">What devices does RepeatLab support?</h3>
            <p class="text-secondary">RepeatLab is currently available for iOS and Android devices.</p>
          </div>
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">Can I import my own music?</h3>
            <p class="text-secondary">Yes, you can import your own music files in various formats including MP3 and WAV.</p>
          </div>
          <div class="border-b border-secondary-container pb-6">
            <h3 class="text-xl font-bold mb-2 text-secondary">Is there a limit to how many loops I can create?</h3>
            <p class="text-secondary">No, you can create as many loops as you need within each song.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-primary text-surface">
      <div class="max-w-4xl mx-auto text-center px-4 md:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-display font-bold mb-6">Ready to Transform Your Practice?</h2>
        <p class="text-xl mb-8">Download RepeatLab today and take your music practice to the next level.</p>
        <div class="flex justify-center gap-4">
            <a href="https://apps.apple.com/us/app/audio-looper-speed-changer/id6740175553" target="_blank" class="flex items-center gap-2">
              <img src="/images/app-store-badge-black.png" alt="Download on App Store" class="h-12">
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.repeatlab.app" target="_blank" class="flex items-center gap-2">
              <img src="/images/google-play-badge.png" alt="Get it on Google Play" class="h-12">
            </a>
          </div>
      </div>
    </section>
  </main>

  <footer class="bg-surface-container text-secondary py-8">
    <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-4">
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/privacy" class="hover:text-primary transition-colors">Privacy Policy</a>
          <a href="/legal" class="hover:text-primary transition-colors">Legal Notices</a>
          <a href="/terms" class="hover:text-primary transition-colors">Terms & Conditions</a>
        </div>
        <p>&copy; {new Date().getFullYear()} RepeatLab</p>
      </div>
    </div>
  </footer>
</Layout> 