---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — RepeatLab"
  description="This page doesn't exist. Head back to RepeatLab, the audio & video looper for musicians."
>
  <main
    class="min-h-screen flex flex-col items-center justify-center text-center px-4"
  >
    <h1 class="text-5xl font-display font-bold text-primary mb-4">404</h1>
    <p class="text-xl text-secondary mb-8">
      This page doesn't exist — but your practice loop is waiting.
    </p>
    <a
      href="/"
      class="bg-primary text-surface font-bold rounded-full px-8 py-3 hover:opacity-90 transition-opacity"
      >Back to RepeatLab</a
    >
  </main>
</Layout>
